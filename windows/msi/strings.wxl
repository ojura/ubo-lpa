<?xml version="1.0" encoding="utf-8"?>
<!-- Texts of the setup wizard: ubo-lpa's own pages, and WiX's where they differ from its defaults. -->
<WixLocalization Culture="en-US" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="WelcomeDlgTitle" Value="{\WixUI_Font_Bigger}ubo-lpa: uBlock Origin for Chrome" />
  <String Id="WelcomeDlgDescription" Value="Setup installs uBlock Origin from its official releases, patched to run in Chrome as a legacy packaged app, and keeps it up to date. ubo-lpa is not affiliated with the uBlock Origin project." />

  <String Id="UboDlgTitle" Value="[ProductName] Setup" />

  <String Id="UboReleaseTitle" Value="{\WixUI_Font_Title}uBlock Origin release" />
  <String Id="UboReleaseDescription" Value="Choose the uBlock Origin release that Setup patches and installs." />
  <String Id="UboReleaseNewest" Value="The &amp;newest release, downloaded from GitHub" />
  <String Id="UboReleaseBundled" Value="The release &amp;bundled with this installer" />
  <String Id="UboReleaseNoGitHub" Value="Setup could not reach GitHub, so the bundled release is selected." />
  <String Id="UboReleaseNote" Value="Both are uBlock Origin's own releases, which Setup patches to run as a legacy packaged app. The daily update always installs the newest release." />
  <String Id="UboProbeError" Value="Setup could not read Chrome's profiles or check GitHub: [UBOLPA_PROBE_ERROR]" />

  <String Id="UboChromeTitle" Value="{\WixUI_Font_Title}Google Chrome" />
  <String Id="UboChromeDescription" Value="Choose the Chrome profiles that get uBlock Origin." />
  <String Id="UboChromeMissing" Value="Google Chrome was not found. Setup still builds uBlock Origin in its folder; once Chrome is installed, the Start menu entry's Change settings loads it." />
  <String Id="UboChromeNoProfiles" Value="Chrome has no profile yet. Setup starts Chrome, which creates its first profile, and loads uBlock Origin into it." />
  <String Id="UboChromeProfiles" Value="Profiles in [UBOLPA_USER_DATA]:" />
  <String Id="UboChromeMore" Value="and [UBOLPA_PROFILES_MORE] more, which Setup leaves out" />

  <String Id="UboOptionsTitle" Value="{\WixUI_Font_Title}Folder and updates" />
  <String Id="UboOptionsDescription" Value="Choose where uBlock Origin is kept, and how it stays up to date." />
  <String Id="UboOptionsFolder" Value="uBlock Origin and its toolbar button are kept in this folder, which Chrome loads them from:" />
  <String Id="UboOptionsChange" Value="C&amp;hange..." />
  <String Id="UboOptionsMaintenance" Value="Install &amp;maintenance: the updater, a Start menu entry to update, change or remove ubo-lpa, and an entry in the list of installed apps" />
  <String Id="UboOptionsUpdates" Value="&amp;Update uBlock Origin daily" />
  <String Id="UboOptionsPortable" Value="Without maintenance, Setup leaves nothing but the folder above: no updater, Start menu entry, daily update or entry in the list of installed apps. Running this installer, or a newer one, with the same folder updates uBlock Origin." />

  <String Id="UboMaintenanceTitle" Value="{\WixUI_Font_Title}Maintain ubo-lpa" />
  <String Id="UboMaintenanceDescription" Value="uBlock Origin [UBOLPA_INSTALLED_VERSION] is installed." />
  <String Id="UboMaintenanceFolder" Value="Folder: [UBOLPA_DIR]" />
  <String Id="UboMaintenanceUpdate" Value="&amp;Update now" />
  <String Id="UboMaintenanceUpdateText" Value="Install the newest uBlock Origin release if it is newer than this one, and load uBlock Origin into Chrome." />
  <String Id="UboMaintenanceChange" Value="&amp;Change settings" />
  <String Id="UboMaintenanceChangeText" Value="Choose the uBlock Origin release, the Chrome profiles that get it, and whether it updates daily." />
  <String Id="UboMaintenanceRemove" Value="&amp;Remove" />
  <String Id="UboMaintenanceRemoveText" Value="Remove ubo-lpa, uBlock Origin's folder and the daily update. Chrome lists both extensions until they are removed on chrome://extensions." />

  <String Id="VerifyReadyDlgInstallTitle" Value="{\WixUI_Font_Title}Ready to install" />
  <String Id="VerifyReadyDlgInstallText" Value="Click Install to set up uBlock Origin. Setup then loads it into Chrome; Chrome asks once whether to allow remote debugging, and a click on Allow is all it needs. No administrator rights are needed." />
  <String Id="VerifyReadyDlgChangeTitle" Value="{\WixUI_Font_Title}Ready to apply" />
  <String Id="VerifyReadyDlgChangeText" Value="Click Change to update uBlock Origin if a newer release is chosen, apply the daily update setting and load uBlock Origin into the chosen Chrome profiles." />
  <String Id="VerifyReadyDlgRemoveTitle" Value="{\WixUI_Font_Title}Ready to remove" />
  <String Id="VerifyReadyDlgRemoveText" Value="Click Remove to remove ubo-lpa, uBlock Origin's folder and the daily update." />
  <String Id="ProgressDlgTitleInstalling" Value="{\WixUI_Font_Title}Installing uBlock Origin for Chrome" />
  <String Id="ProgressDlgTextInstalling" Value="Building uBlock Origin and loading it into Chrome." />
  <String Id="ExitDialogTitle" Value="{\WixUI_Font_Bigger}uBlock Origin is ready" />
  <String Id="ExitDialogDescription" Value="uBlock Origin is running in Chrome. If Chrome's prompt was declined, Setup opened the steps for loading it by hand." />
</WixLocalization>
