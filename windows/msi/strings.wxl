<?xml version="1.0" encoding="utf-8"?>
<!-- Texts of the setup wizard: ubo-lpa's own pages, and WiX's where they differ from its defaults. -->
<WixLocalization Culture="en-US" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="WelcomeDlgTitle" Value="{\WixUI_Font_Bigger}ubo-lpa: uBlock Origin for Chrome" />
  <String Id="WelcomeDlgDescription" Value="Setup installs uBlock Origin from its official releases, patched to run in Chrome as a legacy packaged app, and keeps it up to date. ubo-lpa is not affiliated with the uBlock Origin project." />

  <String Id="UboDlgTitle" Value="[ProductName] Setup" />

  <String Id="UboReleaseTitle" Value="{\WixUI_Font_Title}uBlock Origin release" />
  <String Id="UboReleaseDescription" Value="Choose the uBlock Origin release that Setup patches and installs." />
  <String Id="UboReleaseNewest" Value="The &amp;newest release, downloaded from GitHub" />
  <String Id="UboReleaseBundled" Value="The release &amp;bundled with this installer" />
  <String Id="UboReleaseNoGitHub" Value="Setup could not reach GitHub, so the bundled release is selected." />
  <String Id="UboReleaseNote" Value="Both are uBlock Origin's own releases, which Setup patches to run as a legacy packaged app. Updates always install the newest release." />
  <String Id="UboProbeError" Value="Setup could not read Chrome's profiles or check GitHub: [UBOLPA_PROBE_ERROR]" />

  <String Id="UboChromeTitle" Value="{\WixUI_Font_Title}Google Chrome" />
  <String Id="UboChromeDescription" Value="Choose the Chrome profiles that get uBlock Origin." />
  <String Id="UboChromeMissing" Value="Google Chrome was not found. Setup still builds uBlock Origin in its folder. Once Chrome is installed, running Setup again loads it into Chrome." />
  <String Id="UboChromeNoProfiles" Value="Chrome has no profile yet. Setup starts Chrome, which creates its first profile, and loads uBlock Origin into it." />
  <String Id="UboChromeProfiles" Value="Profiles in [UBOLPA_USER_DATA]:" />
  <String Id="UboChromeMore" Value="and [UBOLPA_PROFILES_MORE] more, which Setup leaves out" />

  <String Id="UboOptionsTitle" Value="{\WixUI_Font_Title}Installation" />
  <String Id="UboOptionsDescription" Value="Choose the folder, and a full or a portable installation." />
  <String Id="UboOptionsFolder" Value="Folder that Chrome loads uBlock Origin and its toolbar button from:" />
  <String Id="UboOptionsChange" Value="C&amp;hange..." />
  <String Id="UboOptionsFull" Value="&amp;Full installation" />
  <String Id="UboOptionsFullText" Value="Installs the maintenance tool, which updates uBlock Origin and can change or remove ubo-lpa from the Start menu." />
  <String Id="UboOptionsUpdates" Value="&amp;Check for and install uBlock Origin updates" />
  <String Id="UboIntervalDaily" Value="Daily" />
  <String Id="UboIntervalWeekly" Value="Weekly" />
  <String Id="UboIntervalBiweekly" Value="Every 2 weeks" />
  <String Id="UboIntervalMonthly" Value="Monthly" />
  <String Id="UboOptionsPortableChoice" Value="&amp;Portable" />
  <String Id="UboOptionsPortable" Value="Installs the chosen uBlock Origin release into Chrome and leaves only the folder above, with no updates, Start menu entries or entry in the list of installed apps. Running Setup again with the same folder updates it." />

  <String Id="UboMaintenanceTitle" Value="{\WixUI_Font_Title}Maintain ubo-lpa" />
  <String Id="UboMaintenanceDescription" Value="uBlock Origin [UBOLPA_INSTALLED_VERSION] is installed." />
  <String Id="UboMaintenanceFolder" Value="Folder: [UBOLPA_DIR]" />
  <String Id="UboMaintenanceUpdate" Value="&amp;Update now" />
  <String Id="UboMaintenanceUpdateText" Value="Install the newest uBlock Origin release if it is newer than this one, and load uBlock Origin into Chrome." />
  <String Id="UboMaintenanceChange" Value="&amp;Change settings" />
  <String Id="UboMaintenanceChangeText" Value="Choose the uBlock Origin release, the Chrome profiles that get it, and how often it is updated." />
  <String Id="UboMaintenanceRemove" Value="&amp;Remove" />
  <String Id="UboMaintenanceRemoveText" Value="Remove ubo-lpa, uBlock Origin's folder and the update checks. Chrome lists both extensions until they are removed on chrome://extensions." />

  <String Id="VerifyReadyDlgInstallTitle" Value="{\WixUI_Font_Title}Ready to install" />
  <String Id="VerifyReadyDlgInstallText" Value="Click Install to set up uBlock Origin. Setup then loads it into Chrome, which asks once whether to allow remote debugging: click Allow. No administrator rights are needed." />
  <String Id="VerifyReadyDlgChangeTitle" Value="{\WixUI_Font_Title}Ready to apply" />
  <!-- Update now and Change settings both reach the Ready page in Change mode;
       their buttons on the maintenance page set UBOLPA_READY_TEXT. -->
  <String Id="VerifyReadyDlgChangeText" Value="[UBOLPA_READY_TEXT]" />
  <String Id="UboReadyChangeText" Value="Click Change to update uBlock Origin if a newer release is chosen, apply the update setting and load uBlock Origin into the chosen Chrome profiles." />
  <String Id="UboReadyUpdateText" Value="Click Change to install the newest uBlock Origin release if it is newer than the installed one, and load uBlock Origin into Chrome." />
  <String Id="VerifyReadyDlgRemoveTitle" Value="{\WixUI_Font_Title}Ready to remove" />
  <String Id="VerifyReadyDlgRemoveText" Value="Click Remove to remove ubo-lpa, uBlock Origin's folder and the update checks." />
  <String Id="ProgressDlgTitleInstalling" Value="{\WixUI_Font_Title}Installing uBlock Origin for Chrome" />
  <String Id="ProgressDlgTextInstalling" Value="Building uBlock Origin and loading it into Chrome." />
  <!-- The Finish page differs after Remove, and when Setup does not load
       uBlock Origin into Chrome; ui.wxs sets UBOLPA_EXIT_TITLE and _TEXT. -->
  <String Id="ExitDialogTitle" Value="{\WixUI_Font_Bigger}[UBOLPA_EXIT_TITLE]" />
  <String Id="ExitDialogDescription" Value="[UBOLPA_EXIT_TEXT]" />
  <String Id="UboExitReadyTitle" Value="uBlock Origin is ready" />
  <String Id="UboExitReadyText" Value="uBlock Origin is running in Chrome, unless its prompt was declined: Setup then offered the steps for loading it by hand." />
  <String Id="UboExitNotLoadedTitle" Value="uBlock Origin is installed" />
  <String Id="UboExitNotLoadedText" Value="Setup did not load it into Chrome: Chrome was not found, or no profile was ticked. Running Setup again loads it." />
  <String Id="UboExitRemovedTitle" Value="ubo-lpa is removed" />
  <String Id="UboExitRemovedText" Value="Its folder and the update checks are removed. Remove both extensions on chrome://extensions as well." />
</WixLocalization>
