#!/usr/bin/env bash
set -euo pipefail

shim_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
shim="$shim_dir/preload/\$LIB/libwine-tcp-preload.so"

make -C "$shim_dir" preload

if [[ -n "${LD_PRELOAD:-}" ]]; then
    export LD_PRELOAD="$shim:$LD_PRELOAD"
else
    export LD_PRELOAD="$shim"
fi

exec "$@"
